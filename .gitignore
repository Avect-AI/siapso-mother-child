# Dependencies and builds
node_modules/
.pnpm-store/
dist/
dist-demo/
build/
coverage/
.vite/
.turbo/
*.tsbuildinfo

# Python
__pycache__/
*.pyc
.venv/
venv/

# Local settings, never committed
.env
.env.*
!.env.example
# The demo mode of the app holds no secret: it only allows an unsigned pack (docs/pack-signing.md)
!app/.env.demo
.claude/settings.local.json
**/.impeccable/config.local.json
**/.impeccable/cache/
**/.impeccable/live/
**/.impeccable/questions/
**/.impeccable/critique/

# Secrets and keys, never committed
*.pem
*.key
*_accessKeys.csv
secrets*.yaml

# Large model files: published on Hugging Face, not in git
*.onnx
*.safetensors
*.bin

# impeccable engine binaries: downloaded and checksum-verified by its launcher
.claude/skills/impeccable/scripts/bin/

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Knowledge pack built from knowledge/ and registry/
app/public/pack/

# Referral contacts of a deployment (real phone numbers): never committed.
# app/public/config/referral.example.json shows the form.
app/public/config/referral.json

# Voice pack: converted model files, never committed (speech/convert/README.md)
app/public/voice/
speech/convert/out/

# Prescription reading pack: models, ONNX Runtime and pdf.js files, never
# committed (pnpm ocr:install-local, docs/ocr.md)
app/public/ocr/
speech/convert/.venv/

# Test and build output
playwright-report/
test-results/

# Pre-publication audit cache: the checksum-verified gitleaks release, the
# reuse tool and the mirror clone (tools/release/audit.sh), never committed
.cache/

# Local agent workflow notes
.superpowers/
# Local agent worktrees
.claude/worktrees/

# The 537-byte MatMulNBits test fixture is not a model weight
!speech/test/fixtures/matmulnbits-4bit.onnx

# Voice training: FLEURS audio cache and runs, never committed
fleurs-cache/
speech/train/runs/

# DHIS2 export: restricted data, never committed
open-data/dhis2/out/
