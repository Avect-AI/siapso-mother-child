# SPDX-License-Identifier: MIT
# Pinned set for the fine-tuning script (speech/train/README.md), separate from
# the conversion set of speech/convert/. GPU training on Linux x86_64 with a
# CUDA 12.8 driver (the CUDA wheels of PyPI torch). Every version, transitive
# ones included, was published on or before 2026-10-22, like the conversion set.
# Regenerate requirements.txt with its hashes, from the conversion venv:
#   speech/convert/.venv/Scripts/python speech/convert/lock.py hash --dir speech/train
#   speech/convert/.venv/Scripts/python speech/convert/lock.py check --dir speech/train
# lock-platforms: linux-x86_64
# lock-pythons: 3.11 3.12

