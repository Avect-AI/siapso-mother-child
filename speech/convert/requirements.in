# SPDX-License-Identifier: MIT
# Pinned set for the conversion and the quick check (speech/convert/README.md).
# Edit this file, then regenerate requirements.txt with its hashes:
#   speech/convert/.venv/Scripts/python speech/convert/lock.py hash
#   speech/convert/.venv/Scripts/python speech/convert/lock.py check
# Every version, transitive ones included, was published on or before
# 2026-10-20 (PyPI and PyTorch index dates checked on 2026-11-04).
# optimum-onnx 0.1.0 requires optimum 2.1 and transformers below 4.58, which
# fixes the rest of the set; onnxruntime 1.23.2 needs Python 3.10 to 3.12
# here. Supported: Windows x86_64, Linux x86_64 and aarch64, macOS arm64.
--extra-index-url https://download.pytorch.org/whl/cpu

# Direct requirements. torch: the CPU build (the PyPI build for Linux pulls
# the CUDA libraries); macOS has a single build.
torch==2.8.0+cpu ; sys_platform != "darwin"
torch==2.8.0 ; sys_platform == "darwin"
transformers==4.57.6
optimum==2.1.0
optimum-onnx[onnxruntime]==0.1.0
onnx==1.19.1
onnxruntime==1.23.2
numpy==2.2.6
huggingface-hub==0.36.2
tokenizers==0.22.2
safetensors==0.7.0
soundfile==0.14.0

