{
  "name": "@siapso/speech",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p bench",
    "eval": "tsx eval/run.ts",
    "bench": "vite build --config bench/vite.config.ts && playwright test --config bench/playwright.config.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@siapso/pack-tools": "workspace:*",
    "@siapso/resolver": "workspace:*",
    "ajv": "8.20.0",
    "tsx": "4.23.15",
    "vite": "8.3.4",
    "yaml": "2.9.1"
  }
}
