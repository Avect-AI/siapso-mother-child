{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SIAPSO plant",
  "description": "One traditional remedy, one file in registry/plants/ named after its id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "latin-name",
    "names",
    "local-names",
    "parts",
    "evidence",
    "message",
    "sources"
  ],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "latin-name": { "type": "string", "pattern": "\\S" },
    "names": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fr", "en"],
      "properties": {
        "fr": { "type": "string", "pattern": "\\S" },
        "en": { "type": "string", "pattern": "\\S" }
      }
    },
    "local-names": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "lang", "checked"],
        "properties": {
          "text": { "type": "string", "pattern": "\\S" },
          "lang": { "enum": ["fr", "wo", "en"] },
          "checked": { "type": "boolean" }
        }
      }
    },
    "parts": { "type": "array", "items": { "$ref": "#/$defs/id" } },
    "evidence": { "enum": ["A", "B", "C", "D", "E", "0"] },
    "message": { "$ref": "#/$defs/id" },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source-ref" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "source-ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "locator", "accessed"],
      "properties": {
        "source": { "$ref": "#/$defs/id" },
        "locator": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "accessed": { "type": "string", "format": "date" },
        "quote": { "type": "string" }
      }
    }
  }
}
