# SPDX-License-Identifier: MIT
# Vite mode "demo" (pnpm build at the repository root, into app/dist-demo): a
# test or demo build that accepts an unsigned knowledge pack. Never published
# as a release; a production build (pnpm release:build) refuses this
# variable. See docs/pack-signing.md.
VITE_ALLOW_UNSIGNED_PACK=true
