{
  "name": "siapso-mother-child",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "knowledge:check": "siapso-pack check",
    "knowledge:build": "siapso-pack build",
    "knowledge:sign": "siapso-pack sign",
    "knowledge:keygen": "siapso-pack keygen",
    "knowledge:import-bdpm": "siapso-pack import-bdpm",
    "eval:resolver": "pnpm --filter @siapso/pack-tools exec tsx src/eval-resolver.ts",
    "eval:prescription": "pnpm --filter @siapso/prescription-eval eval",
    "build": "pnpm knowledge:build && pnpm -r --filter \"!@siapso/app\" --if-present build && pnpm --filter @siapso/app build:demo",
    "release:build": "node tools/release/release-build.mjs",
    "open-data:sample": "node tools/open-data/bin/siapso-open-data.js sample --output open-data/test-data/events.sample.jsonl --label \"TEST DATA: synthetic events, not real people\"",
    "open-data:build": "node tools/open-data/bin/siapso-open-data.js build --input open-data/test-data/events.sample.jsonl --week 2026-W45 --release r1 --release-date 2026-12-06 --out-dir open-data/published --test",
    "budget:app": "node tools/budget/check-app-size.mjs app/dist-demo",
    "e2e": "pnpm --filter @siapso/app e2e",
    "server:start": "node server/bin/siapso-server.js",
    "voice:convert": "sh tools/hygiene/py.sh speech/convert/convert.py",
    "voice:install-local": "node speech/scripts/install-local.mjs",
    "eval:speech": "pnpm --filter @siapso/speech eval",
    "voice:bench": "pnpm --filter @siapso/speech bench"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@siapso/pack-tools": "workspace:*",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
